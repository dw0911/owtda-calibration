# ============================================================
# OW-TDA-CAL-R1 .gitignore
# 行尾策略见 .gitattributes（2026-09-20 修订）：
#   科学对象/冻结对象 → `-text`（exact bytes，SHA256 绑定）；
#   源码/文档/CI      → `text eol=lf`。
# ============================================================

# --- Python / 工具噪音 ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
.ipynb_checkpoints/

# --- 虚拟环境与锁运行时产物 ---
.venv/
venv/

# --- IDE / 系统 ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 临时文件 ---
*.log.tmp
*.tmp
*.bak
*_scratch/

# --- 隔离秘密（不入库）：REAL task root key / task id salt 明文 ---
secrets/

# ============================================================
# 大数据与本地证据（不推送）
# 出处、SHA256 与再生成方式见 reproducibility/ 与 data/manifests/
# ============================================================
# 原始账本（H0/H1 evaluation+feature，合计约 3.2 GB，超过 GitHub 单文件限制）
artifacts/ledgers/
# 大型派生索引（ACTIVE_*_INDEX，7–140 MB；由冻结计划与种子可再生成）
governance/ACTIVE_*_INDEX_*.jsonl
# 外部归档下载目标目录（只保留 .gitkeep）
data/external/*
!data/external/.gitkeep

# --- LaTeX 严格构建哨兵（CI 用 touch 生成；不入库） ---
paper/STRICT.tex

# --- LaTeX 编译中间件（可再生；paper/main.pdf 与 *.tex 仍会入库） ---
paper/*.aux
paper/*.blg
paper/*.log
paper/*.out
paper/*.bbl
paper/*.synctex.gz

# --- 本地数据（如按 DATA_SOURCES.md 放入仓库工作目录时；目录本身不忽略，只有内容） ---
data/sample/*
!data/sample/.gitkeep
data/raw/*
data/raw_download/*
